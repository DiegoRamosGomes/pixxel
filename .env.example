# --- Backend (apps/backend/.env) ---

# Provedor LLM (OpenAI-compatible). Default: NVIDIA NIM.
# Para trocar de provedor, basta mudar BASE_URL e MODELS.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Lista de modelos em ordem de prioridade. O primeiro que responder é usado;
# em caso de 429/5xx/model_not_found, o bridge cai pro próximo automaticamente.
# Exemplos NVIDIA NIM:
#   meta/llama-3.3-70b-instruct
#   nvidia/llama-3.1-nemotron-70b-instruct
#   mistralai/mixtral-8x22b-instruct-v0.1
#   qwen/qwen2.5-coder-32b-instruct
LLM_MODELS=meta/llama-3.3-70b-instruct,nvidia/llama-3.1-nemotron-70b-instruct,mistralai/mixtral-8x22b-instruct-v0.1

# Token compartilhado cliente↔servidor (MVP, single-user)
# Gere algo aleatório longo: openssl rand -hex 32
CLIENT_TOKEN=change-me-to-a-long-random-string

# Porta do servidor
PORT=8080

# YouTube Data API v3 (opcional). Com a chave, busca usa a API oficial (mais
# robusta, com filtros como order=date e busca de canal). Sem ela, cai pra
# scraping. Pra obter: https://console.cloud.google.com → habilita "YouTube
# Data API v3" → Credentials → Create → API key.
YOUTUBE_API_KEY=

# ClickUp Personal API Token (opcional). Habilita comandos de leitura de tasks.
# Pra obter: ClickUp → Settings → Apps → Generate API Token. Formato pk_...
CLICKUP_TOKEN=

# Prefixo do custom_id do seu workspace no ClickUp (sem o '-'). Ex: pra tasks
# "DEV-6074" o prefixo é DEV. Quando você falar só "task 6074", o backend
# prefixa automaticamente. Se não souber, deixe em branco.
CLICKUP_TASK_PREFIX=

# Trello API Key + Token (opcional). Habilita criar/editar/mover/arquivar
# cards por voz. Diferente do ClickUp (read-only), aqui escrita é parte do
# contrato — operações destrutivas (archive, remove_label) pedem confirmação
# por voz antes de executar.
# Pra obter: https://trello.com/app-key — API Key vem direto da página;
# clica em "Token" no topo pra gerar o token de acesso pessoal.
TRELLO_API_KEY=
TRELLO_TOKEN=

# --- Desktop (apps/desktop/.env) ---
# URL do WebSocket. Em dev: ws://localhost:8080/ws. Em prod: wss://seu-dominio/ws
WS_URL=ws://localhost:8080/ws

# Modelo de voz do Piper (sem extensão). Espera achar
# apps/desktop/resources/piper/<PIPER_VOICE>.onnx + .onnx.json
# Recomendado: pt_BR-cadu-medium (mais natural). Alternativas:
# pt_BR-faber-medium, pt_BR-edresson-low
PIPER_VOICE=pt_BR-cadu-medium

# Velocidade da fala. <1 = mais rápido, >1 = mais lento. Default Piper: 1.0
PIPER_LENGTH_SCALE=0.95

# Pausa entre sentenças em segundos. Default Piper: 0.2 (engasga). 0.05 fica fluido.
PIPER_SENTENCE_SILENCE=0.05
