# Token compartilhado com os clientes (desktop, celular). Gere com `openssl rand -hex 32`.
CLIENT_TOKEN=

# Secret usado pelo Expo pra assinar os webhooks (eas webhook:create --secret).
# Sem este valor, todos os requests com header expo-signature são rejeitados.
EXPO_WEBHOOK_SECRET=

# Porta HTTP/WebSocket da API (dev). No Docker é 3000.
PORT=8080

# Pasta de dados (memória, planos de estudo, registros, estado). Default: ~/pixxel
PIXXEL_DATA_DIR=

# Gemini (voz ao vivo, visão, embeddings, resumo de vídeo, classificação de e-mail).
GEMINI_API_KEY=
# Voz prebuilt do Gemini Live (Charon, Puck, Fenrir, Orus, Kore, Aoede, Leda, Zephyr).
GEMINI_VOICE=
GEMINI_LIVE_LANGUAGE=
GEMINI_LIVE_MODEL=
# Quanto a API espera um cliente responder uma função local (ms).
LOCAL_TOOL_TIMEOUT_MS=15000

# Provedor LLM OpenAI-compatible (NVIDIA NIM) — usado como fallback de visão/texto.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODELS=
NVIDIA_VISION_MODEL=
NVIDIA_TEXT_MODEL=

# YouTube Data API v3 (busca de vídeos, play_youtube, planos de estudo).
YOUTUBE_API_KEY=

# ClickUp Personal API Token (pk_...) e prefixo do custom_id (ex: DEV).
CLICKUP_TOKEN=
CLICKUP_TASK_PREFIX=

# Trello: https://trello.com/app-key (API Key + Token pessoal).
TRELLO_API_KEY=
TRELLO_TOKEN=

# Busca na web (Tavily).
TAVILY_API_KEY=

# Instagram (token de System User) + Cloudinary (upload temporário pra publicar).
INSTAGRAM_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail via IMAP (senha de app).
GMAIL_USER=
GMAIL_APP_PASS=

# ntfy: push pro celular. Inscreva o mesmo tópico no app ntfy.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
