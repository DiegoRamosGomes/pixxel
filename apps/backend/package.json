    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "imapflow": "^1.3.3",
    "mailparser": "^3.9.8",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "youtube-transcript": "^1.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
